{
    "projectId": "89073a1a-b055-4ad2-8499-87445026c626",
    "shape": "storybook",
    "pkg": "@aragon/gov-ui-kit",
    "globalName": "GovUiKit",
    "entry": "packages/gov-ui-kit/dist/index.es.js",
    "cssEntry": "build.css",
    "buildCmd": "pnpm -F \"@aragon/gov-ui-kit...\" build",
    "storybookStatic": ".design-sync/sb-reference",
    "storybookConfigDir": "packages/gov-ui-kit/.storybook",
    "readmeHeader": ".design-sync/conventions.md",
    "guidelinesGlob": [
        "../../.design-sync/guidelines/*.md",
        "src/theme/tokens/index.mdx",
        "src/modules/index.mdx",
        "src/modules/components/gukModulesProvider/gukModulesProvider.mdx",
        "src/core/components/gukCoreProvider/gukCoreProvider.mdx"
    ],
    "provider": {
        "component": "GukModulesProvider"
    },
    "overrides": {
        "CardSummary": {
            "cardMode": "column"
        },
        "CheckboxCard": {
            "cardMode": "column"
        },
        "DataList": {
            "cardMode": "column"
        },
        "InputText": {
            "skip": [
                "core-components-forms-inputtext--addon"
            ]
        },
        "ProposalActions": {
            "cardMode": "single",
            "primaryStory": "Default",
            "skip": [
                "modules-components-proposal-proposalactions-proposalactions-decoder--string-array-type",
                "modules-components-proposal-proposalactions-proposalactions-item--moveable"
            ]
        },
        "ProposalVoting": {
            "cardMode": "column"
        },
        "ProposalVotingProgress": {
            "cardMode": "column"
        },
        "Tabs": {
            "cardMode": "column"
        }
    },
    "storyImports": {
        "shim": [
            "packages/gov-ui-kit/src/"
        ],
        "bundle": [
            "StoryComponent",
            "proposalActionsTestUtils",
            "proposalActionsDecoder",
            "proposalVotingContext",
            ".css"
        ]
    }
}
