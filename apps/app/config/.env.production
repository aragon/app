# URL of the Aragon backend
ARAGON_BACKEND_URL=https://backend.aragonservices.in

# Application environment
NEXT_PUBLIC_ENV=production

# Project ID from Wallet Connect
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=33951d0c4045078ce2d8bd06506174c7

# Allowed domain for API requests
NEXT_PUBLIC_API_ALLOWED_DOMAIN=https://app.aragon.org

# API version for Aragon backend service (v2 for production, v3 for dev/sandbox)
NEXT_PUBLIC_API_VERSION=v3

# Advanced governance cutoff timestamp: 2026-04-02 00:00:01 UTC
NEXT_PUBLIC_GOVERNANCE_ADVANCED_CUTOFF_TIMESTAMP=1775088001

# URL of the Aragon assistant service (support chat API)
NEXT_PUBLIC_ASSISTANT_URL=https://assistant.aragon.org

# Plausible site domain; unset in environments that should not send analytics events
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=app.aragon.org

# Telegram bot handle used for DAO notification subscriptions (https://t.me/<name>?start=<daoId>); unset until the production bot is live
NEXT_PUBLIC_TELEGRAM_BOT_NAME=aragon_notifications_bot
