# URL of the Aragon backend
ARAGON_BACKEND_URL=https://dev.backend.aragonservices.in

# Application environment
NEXT_PUBLIC_ENV=development

# Project ID from Wallet Connect
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=64b75866f42573712948d2ff731051a6

# Allowed domain for API requests
NEXT_PUBLIC_API_ALLOWED_DOMAIN=https://dev.app.aragon.org/

# API version for Aragon backend service (v2 for production, v3 for dev/sandbox)
NEXT_PUBLIC_API_VERSION=v3

# Advanced governance cutoff timestamp: 2026-04-02 00:00:01 UTC
NEXT_PUBLIC_GOVERNANCE_ADVANCED_CUTOFF_TIMESTAMP=1775088001

# URL of the Aragon assistant service (support chat API; PR previews touching the assistant override this with the assistant preview URL)
NEXT_PUBLIC_ASSISTANT_URL=https://dev.assistant.aragon.org

# Plausible site domain; test site for validating tracking before enabling it in production
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=dev.app.aragon.org

# Telegram bot handle used for DAO notification subscriptions (https://t.me/<name>?start=<daoId>)
NEXT_PUBLIC_TELEGRAM_BOT_NAME=aragon_test_bot
