# Pinata JWT token used for pinning data on IPFS (see https://knowledge.pinata.cloud/en/articles/6191471-how-to-create-an-pinata-api-key)
NEXT_SECRET_IPFS_JWT=YOUR_VALUE_HERE

# Alchemy key to use for RPC requests (see https://www.alchemy.com/support/how-to-create-a-new-alchemy-api-key)
NEXT_SECRET_RPC_KEY=YOUR_VALUE_HERE

# Ankr key to use for RPC requests (see https://www.ankr.com/rpc/projects/)
NEXT_SECRET_ANKR_RPC_KEY=YOUR_VALUE_HERE

# dRPC key to use for RPC requests (see https://drpc.org/)
NEXT_SECRET_DRPC_RPC_KEY=YOUR_VALUE_HERE

# Api key for connecting to the Aragon backend service
NEXT_SECRET_ARAGON_BACKEND_API_KEY=YOUR_VALUE_HERE

# Envio API key and endpoint
NEXT_SECRET_ENVIO_GRAPHQL_ENDPOINT=YOUR_VALUE_HERE
NEXT_SECRET_ENVIO_API_TOKEN=YOUR_VALUE_HERE

# --- MPC systems POC (mock co-signer, see src/modules/mpc/README.md) ---
# AES-256 key (32 bytes hex) used to encrypt the server share at rest. Generate with: openssl rand -hex 32
# Optional in local/dev (a deterministic dev key is used with a warning), required in production.
MPC_POC_SERVER_KEY=YOUR_VALUE_HERE
# Sepolia RPC used for balance, gas estimation and broadcast (defaults to https://ethereum-sepolia-rpc.publicnode.com)
MPC_POC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# POC self-registration endpoint (/api/mpc/auth/register): enabled by default outside production, in production
# only when explicitly set to "true". Set to "false" to disable it everywhere.
MPC_POC_ALLOW_REGISTER=true
# Path of the JSON store file (defaults to apps/app/.mpc-poc/store.json, git-ignored)
MPC_POC_STORE_PATH=
