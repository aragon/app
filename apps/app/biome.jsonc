{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "root": false,
    "extends": "//",
    "tailwind": {
        "stylesheet": "src/modules/application/components/layouts/layoutRoot/layoutRoot.css"
    },
    "files": {
        // files.includes of a nested config replaces the root list, so the shared exclusions repeat here.
        "includes": [
            "**",
            "!**/*.svg",
            "!snapshots",
            "!src/modules/application/components/layouts/layoutRoot/breakpoints.css",
            "!public/web-workers"
        ]
    },
    "formatter": {
        "includes": [
            "**",
            "!src/app/manifest.json",
            "!src/assets/locales/**"
        ]
    },
    // Primitive palette colour classes (bg-primary-400, shadow-neutral-md, focus-ring-primary, var(--color-…)) while the
    // app moves to the GovKit semantic colour layer (T-02). The .grit files are the kit's, generated from its primitive
    // theme (`pnpm --filter @aragon/gov-ui-kit lint:colors:generate`). Warnings everywhere, errors for the module folders
    // at zero findings: to make a folder strict, add its glob to the `error` plugin of each language AND the same glob
    // negated ("!…") to the matching `warn` plugin; `pnpm lint:colors:check` verifies the scopes stay disjoint and
    // `pnpm lint:colors:report` prints the remaining findings per module folder. Per-DAO page headers are brand art,
    // drawn over the DAO's own artwork, and are never themed: they are left out.
    "plugins": [
        {
            "path": "../../packages/gov-ui-kit/biome-plugins/primitive-colors.js.warn.grit",
            "resolutionKind": "config",
            "includes": [
                "src/**/*.ts",
                "src/**/*.tsx",
                "!**/*.test.ts",
                "!**/*.test.tsx",
                "!**/*.stories.tsx",
                "!src/test/**",
                "!src/__mocks__/**",
                "!src/shared/testUtils/**",
                "!src/daos/*/components/*PageHeader/**",
                "!src/app/**",
                "!src/actions/core/**",
                "!src/actions/crossChainController/**",
                "!src/actions/multisig/**",
                "!src/actions/token/**",
                "!src/daos/alchemix/**",
                "!src/daos/aragonDemo/**",
                "!src/daos/aragonDemoPolicies/**",
                "!src/daos/boundless/**",
                "!src/daos/xmaquina/**",
                "!src/modules/createDao/**",
                "!src/modules/ens/**",
                "!src/modules/governance/**",
                "!src/plugins/adminPlugin/**",
                "!src/plugins/capitalDistributorPlugin/**",
                "!src/plugins/crossChainControllerPlugin/**",
                "!src/plugins/lockToVotePlugin/**",
                "!src/plugins/multisigPlugin/**",
                "!src/plugins/sppPlugin/**",
                "!src/shared/api/**",
                "!src/shared/constants/**",
                "!src/shared/featureFlags/**",
                "!src/shared/hooks/**",
                "!src/shared/lib/**",
                "!src/shared/security/**",
                "!src/shared/types/**",
                "!src/shared/utils/**",
                "!src/daos/cryptex/**",
                "!src/daos/gaugeDistributions/**",
                "!src/daos/katana/**",
                "!src/modules/dashboard/**",
                "!src/modules/explore/**",
                "!src/modules/finance/**",
                "!src/modules/permissions/**",
                "!src/modules/safe/**",
                "!src/plugins/safeMultisigPlugin/**"
            ]
        },
        {
            "path": "../../packages/gov-ui-kit/biome-plugins/primitive-colors.js.error.grit",
            "resolutionKind": "config",
            "includes": [
                "src/app/**",
                "src/actions/core/**",
                "src/actions/crossChainController/**",
                "src/actions/multisig/**",
                "src/actions/token/**",
                "src/daos/alchemix/**",
                "src/daos/aragonDemo/**",
                "src/daos/aragonDemoPolicies/**",
                "src/daos/boundless/**",
                "src/daos/xmaquina/**",
                "src/modules/createDao/**",
                "src/modules/ens/**",
                "src/modules/governance/**",
                "src/plugins/adminPlugin/**",
                "src/plugins/capitalDistributorPlugin/**",
                "src/plugins/crossChainControllerPlugin/**",
                "src/plugins/lockToVotePlugin/**",
                "src/plugins/multisigPlugin/**",
                "src/plugins/sppPlugin/**",
                "src/shared/api/**",
                "src/shared/constants/**",
                "src/shared/featureFlags/**",
                "src/shared/hooks/**",
                "src/shared/lib/**",
                "src/shared/security/**",
                "src/shared/types/**",
                "src/shared/utils/**",
                "src/daos/cryptex/**",
                "src/daos/gaugeDistributions/**",
                "src/daos/katana/**",
                "src/modules/dashboard/**",
                "src/modules/explore/**",
                "src/modules/finance/**",
                "src/modules/permissions/**",
                "src/modules/safe/**",
                "src/plugins/safeMultisigPlugin/**",
                "!**/*.test.ts",
                "!**/*.test.tsx",
                "!**/*.stories.tsx",
                "!src/test/**",
                "!src/__mocks__/**",
                "!src/shared/testUtils/**",
                "!src/daos/*/components/*PageHeader/**"
            ]
        },
        {
            "path": "../../packages/gov-ui-kit/biome-plugins/primitive-colors.css.warn.grit",
            "resolutionKind": "config",
            "includes": [
                "src/**/*.css",
                "!src/app/**",
                "!src/actions/core/**",
                "!src/actions/crossChainController/**",
                "!src/actions/multisig/**",
                "!src/actions/token/**",
                "!src/daos/alchemix/**",
                "!src/daos/aragonDemo/**",
                "!src/daos/aragonDemoPolicies/**",
                "!src/daos/boundless/**",
                "!src/daos/xmaquina/**",
                "!src/modules/createDao/**",
                "!src/modules/ens/**",
                "!src/modules/governance/**",
                "!src/plugins/adminPlugin/**",
                "!src/plugins/capitalDistributorPlugin/**",
                "!src/plugins/crossChainControllerPlugin/**",
                "!src/plugins/lockToVotePlugin/**",
                "!src/plugins/multisigPlugin/**",
                "!src/plugins/sppPlugin/**",
                "!src/shared/api/**",
                "!src/shared/constants/**",
                "!src/shared/featureFlags/**",
                "!src/shared/hooks/**",
                "!src/shared/lib/**",
                "!src/shared/security/**",
                "!src/shared/types/**",
                "!src/shared/utils/**",
                "!src/daos/cryptex/**",
                "!src/daos/gaugeDistributions/**",
                "!src/daos/katana/**",
                "!src/modules/dashboard/**",
                "!src/modules/explore/**",
                "!src/modules/finance/**",
                "!src/modules/permissions/**",
                "!src/modules/safe/**",
                "!src/plugins/safeMultisigPlugin/**"
            ]
        },
        {
            "path": "../../packages/gov-ui-kit/biome-plugins/primitive-colors.css.error.grit",
            "resolutionKind": "config",
            "includes": [
                "src/app/**",
                "src/actions/core/**",
                "src/actions/crossChainController/**",
                "src/actions/multisig/**",
                "src/actions/token/**",
                "src/daos/alchemix/**",
                "src/daos/aragonDemo/**",
                "src/daos/aragonDemoPolicies/**",
                "src/daos/boundless/**",
                "src/daos/xmaquina/**",
                "src/modules/createDao/**",
                "src/modules/ens/**",
                "src/modules/governance/**",
                "src/plugins/adminPlugin/**",
                "src/plugins/capitalDistributorPlugin/**",
                "src/plugins/crossChainControllerPlugin/**",
                "src/plugins/lockToVotePlugin/**",
                "src/plugins/multisigPlugin/**",
                "src/plugins/sppPlugin/**",
                "src/shared/api/**",
                "src/shared/constants/**",
                "src/shared/featureFlags/**",
                "src/shared/hooks/**",
                "src/shared/lib/**",
                "src/shared/security/**",
                "src/shared/types/**",
                "src/shared/utils/**",
                "src/daos/cryptex/**",
                "src/daos/gaugeDistributions/**",
                "src/daos/katana/**",
                "src/modules/dashboard/**",
                "src/modules/explore/**",
                "src/modules/finance/**",
                "src/modules/permissions/**",
                "src/modules/safe/**",
                "src/plugins/safeMultisigPlugin/**"
            ]
        }
    ],
    "linter": {
        "rules": {
            "style": {
                "noRestrictedImports": {
                    "level": "warn",
                    "options": {
                        "paths": {
                            "wagmi": {
                                "importNames": [
                                    "useConnection",
                                    "useEnsAvatar",
                                    "useEnsName"
                                ],
                                "message": "Import ENS hooks from @/modules/ens, wallet account state (address/chainId) from @/modules/application/hooks/useWalletAccount, and connection-gating from @/modules/application/hooks/useWalletConnected. Add biome-ignore with reason if direct wagmi access is needed."
                            },
                            "viem": {
                                "importNames": [
                                    "isAddress"
                                ],
                                "message": "Use addressUtils.isAddress from @aragon/gov-ui-kit instead. Viem's isAddress defaults to strict EIP-55 checksum validation, which rejects otherwise valid mixed-case addresses (e.g. links shared from other tools). If you must use viem directly (e.g. inside a server component, where the gov-ui-kit client shim breaks), biome-ignore this line and pass { strict: false } explicitly."
                            }
                        }
                    }
                }
            }
        }
    },
    "overrides": [
        {
            // Biome reads tsconfig path aliases shaped like package names (@e2e/*, @aragon/gov-ui-kit-original) as packages.
            "includes": [
                "e2e/**",
                "src/shared/lib/@aragon/gov-ui-kit.ts",
                "src/plugins/tokenPlugin/components/tokenSetupMembership/components/tokenSetupMembershipImportToken/tokenSetupMembershipImportToken.tsx"
            ],
            "linter": {
                "rules": {
                    "correctness": {
                        "noUndeclaredDependencies": "off"
                    }
                }
            }
        },
        {
            "includes": [
                "e2e/scripts/**/*.mjs",
                "scripts/**/*.mjs"
            ],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noConsole": "off"
                    }
                }
            }
        }
    ]
}
