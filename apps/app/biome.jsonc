{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "root": false,
    "extends": "//",
    "tailwind": {
        "stylesheet": "src/modules/application/components/layouts/layoutRoot/layoutRoot.css"
    },
    "files": {
        // files.includes of a nested config replaces the root list, so the shared exclusions repeat here.
        "includes": [
            "**",
            "!**/*.svg",
            "!snapshots",
            "!src/modules/application/components/layouts/layoutRoot/breakpoints.css",
            "!public/web-workers"
        ]
    },
    "formatter": {
        "includes": [
            "**",
            "!src/app/manifest.json",
            "!src/assets/locales/**"
        ]
    },
    // Raw spacing classes (p-4, md:gap-3, -mt-2, pt-[72px], space-y-6): padding, margin, gap and space take a GovKit
    // spacing role, a component size or a documented exception. The .grit files are the kit's (`pnpm --filter
    // @aragon/gov-ui-kit lint:spacing:generate`). Production code is at zero findings: an error everywhere, stories
    // only warn. The allowlisted files (geometry, budget outliers and devtools, see the kit's
    // scripts/primitive-spacing.mjs) are left out of both scopes; `lint:spacing:check` keeps them honest.
    // Primitive palette colour classes (bg-primary-400, shadow-neutral-md, focus-ring-primary, var(--color-…)) while the
    // app moves to the GovKit semantic colour layer (T-02). The .grit files are the kit's, generated from its primitive
    // theme (`pnpm --filter @aragon/gov-ui-kit lint:colors:generate`). Warnings everywhere, errors for the module folders
    // at zero findings: to make a folder strict, add its glob to the `error` plugin of each language AND the same glob
    // negated ("!…") to the matching `warn` plugin; `pnpm lint:colors:check` verifies the scopes stay disjoint and
    // `pnpm lint:colors:report` prints the remaining findings per module folder. Per-DAO page headers are brand art,
    // drawn over the DAO's own artwork, and are never themed: they are left out.
    // Primitive type classes (text-sm, md:text-lg, leading-*, font-semibold, font-medium, tracking-*, text-[…px]):
    // text takes a GovKit typography role. The .grit files are the kit's (`pnpm --filter @aragon/gov-ui-kit
    // lint:typography:generate`). Production code is at zero findings: an error everywhere, stories only warn. The
    // allowlisted files (component-owned glyph sizes and the landing hero's fluid size, see the kit's
    // scripts/primitive-typography.mjs) are left out of both scopes; `lint:typography:check` keeps them honest.
    "plugins": [
        {
            "path": "../../packages/gov-ui-kit/biome-plugins/primitive-spacing.js.warn.grit",
            "resolutionKind": "config",
            "includes": [
                "src/**/*.stories.tsx",
                "!src/daos/aragonDemo/components/aragonDemoPageHeader/aragonDemoPageHeader.tsx",
                "!src/daos/aragonDemoPolicies/components/aragonDemoPoliciesPageHeader/aragonDemoPoliciesPageHeader.tsx",
                "!src/daos/boundless/components/boundlessPageHeader/boundlessAvatarIcon.tsx",
                "!src/daos/boundless/components/boundlessPageHeader/boundlessPageHeader.tsx",
                "!src/daos/cryptex/components/cryptexPageHeader/cryptexPageHeader.tsx",
                "!src/modules/application/components/debugPanel/debugPanel.tsx",
