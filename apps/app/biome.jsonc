{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "root": false,
    "extends": "//",
    "tailwind": {
        "stylesheet": "src/modules/application/components/layouts/layoutRoot/layoutRoot.css"
    },
    "files": {
        // files.includes of a nested config replaces the root list, so the shared exclusions repeat here.
        "includes": [
            "**",
            "!**/*.svg",
            "!snapshots",
            "!src/modules/application/components/layouts/layoutRoot/breakpoints.css",
            "!public/web-workers"
        ]
    },
    "formatter": {
        "includes": [
            "**",
            "!src/app/manifest.json",
            "!src/assets/locales/**"
        ]
    },
    // Primitive type classes (text-sm, md:text-lg, leading-*, font-semibold, font-medium, tracking-*, text-[…px]):
    // text takes a GovKit typography role. The .grit files are the kit's (`pnpm --filter @aragon/gov-ui-kit
    // lint:typography:generate`). Production code is at zero findings: an error everywhere, stories only warn. The
    // allowlisted files (component-owned glyph sizes and the landing hero's fluid size, see the kit's
    // scripts/primitive-typography.mjs) are left out of both scopes; `lint:typography:check` keeps them honest.
    "plugins": [
        {
            "path": "../../packages/gov-ui-kit/biome-plugins/primitive-typography.js.warn.grit",
            "resolutionKind": "config",
            "includes": [
                "src/**/*.stories.tsx",
                "!src/modules/settings/components/permissionsGraph/permissionStackNode.tsx",
                "!src/modules/settings/components/permissionInfoTooltip/permissionInfoTooltip.tsx",
                "!src/modules/application/pages/landingPage/landingPage.tsx"
            ]
        },
        {
            "path": "../../packages/gov-ui-kit/biome-plugins/primitive-typography.js.error.grit",
            "resolutionKind": "config",
            "includes": [
                "src/**/*.ts",
                "src/**/*.tsx",
                "!**/*.test.ts",
                "!**/*.test.tsx",
                "!src/**/*.stories.tsx",
                "!src/modules/settings/components/permissionsGraph/permissionStackNode.tsx",
                "!src/modules/settings/components/permissionInfoTooltip/permissionInfoTooltip.tsx",
                "!src/modules/application/pages/landingPage/landingPage.tsx"
            ]
        },
        {
            "path": "../../packages/gov-ui-kit/biome-plugins/primitive-typography.css.warn.grit",
            "resolutionKind": "config",
            "includes": [
                "!src/modules/settings/components/permissionsGraph/permissionStackNode.tsx",
                "!src/modules/settings/components/permissionInfoTooltip/permissionInfoTooltip.tsx",
                "!src/modules/application/pages/landingPage/landingPage.tsx"
            ]
        },
        {
            "path": "../../packages/gov-ui-kit/biome-plugins/primitive-typography.css.error.grit",
            "resolutionKind": "config",
            "includes": [
                "src/**/*.css",
                "!src/modules/settings/components/permissionsGraph/permissionStackNode.tsx",
                "!src/modules/settings/components/permissionInfoTooltip/permissionInfoTooltip.tsx",
                "!src/modules/application/pages/landingPage/landingPage.tsx"
            ]
        }
    ],
    "linter": {
        "rules": {
            "style": {
                "noRestrictedImports": {
                    "level": "warn",
                    "options": {
                        "paths": {
                            "wagmi": {
                                "importNames": [
                                    "useConnection",
                                    "useEnsAvatar",
                                    "useEnsName"
                                ],
                                "message": "Import ENS hooks from @/modules/ens, wallet account state (address/chainId) from @/modules/application/hooks/useWalletAccount, and connection-gating from @/modules/application/hooks/useWalletConnected. Add biome-ignore with reason if direct wagmi access is needed."
                            },
                            "viem": {
                                "importNames": [
                                    "isAddress"
                                ],
                                "message": "Use addressUtils.isAddress from @aragon/gov-ui-kit instead. Viem's isAddress defaults to strict EIP-55 checksum validation, which rejects otherwise valid mixed-case addresses (e.g. links shared from other tools). If you must use viem directly (e.g. inside a server component, where the gov-ui-kit client shim breaks), biome-ignore this line and pass { strict: false } explicitly."
                            }
                        }
                    }
                }
            }
        }
    },
    "overrides": [
        {
            // Biome reads tsconfig path aliases shaped like package names (@e2e/*, @aragon/gov-ui-kit-original) as packages.
            "includes": [
                "e2e/**",
                "src/shared/lib/@aragon/gov-ui-kit.ts",
                "src/plugins/tokenPlugin/components/tokenSetupMembership/components/tokenSetupMembershipImportToken/tokenSetupMembershipImportToken.tsx"
            ],
            "linter": {
                "rules": {
                    "correctness": {
                        "noUndeclaredDependencies": "off"
                    }
                }
            }
        },
        {
            "includes": [
                "e2e/scripts/**/*.mjs",
                "scripts/**/*.mjs"
            ],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noConsole": "off"
                    }
                }
            }
        }
    ]
}
