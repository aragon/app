                "!src/modules/application/components/navigations/navigationWizard/navigationWizard.tsx",
                "!src/modules/application/components/navigations/navigationWorkspace/navigationWorkspace.tsx",
                "!src/modules/application/pages/landingPage/landingPage.tsx",
                "!src/modules/capitalFlow/components/dispatchPanel/dispatchPanel.tsx",
                "!src/modules/capitalFlow/dialogs/dispatchDialog/dispatchSimulationDialog.tsx",
                "!src/modules/capitalFlow/dialogs/setupStrategyDialog/setupStrategyDialogDistributionRecipients/setupStrategyDialogDistributionRecipientItem.tsx",
                "!src/modules/capitalFlow/dialogs/setupStrategyDialog/setupStrategyDialogDistributionStream/setupStrategyDialogDistributionStreamRecipientItem.tsx",
                "!src/modules/createDao/components/createProcessForm/createProcessFormGovernance/fields/governanceStagesField/governanceStagesField.tsx",
                "!src/modules/createDao/components/createProcessForm/createProcessFormProposalCreation/existingConditionCard.tsx",
                "!src/modules/explore/pages/exploreDaosPage/exploreDaosPageClient.tsx",
                "!src/modules/workspace/components/createWorkspaceForm/createWorkspaceFormAccounts/createWorkspaceFormAccountsItem.tsx",
                "!src/modules/workspace/components/createWorkspaceForm/createWorkspaceFormTargets/createWorkspaceFormTargetsItem.tsx",
                "!src/shared/components/forms/resourcesInput/resourcesInputItem.tsx",
                "!src/modules/workspace/components/workspaceAccountSelector/workspaceAccountSelector.tsx",
                "!src/modules/workspace/components/workspaceSelector/workspaceSelector.tsx",
                "!src/modules/workspace/components/workspaceAccountStateCard/workspaceAccountStateCard.tsx",
                "!src/modules/workspace/pages/workspaceDetailsPage/workspaceDetailsPageClient.tsx",
                "!src/plugins/gaugeVoterPlugin/components/gaugeVoterVotingTerminal/gaugeVoterVotingTerminal.tsx",
                "!src/plugins/gaugeVoterPlugin/dialogs/gaugeVoterVoteDialog/gaugeVoterVoteDialogItem/gaugeVoterVoteDialogItem.tsx",
                "!src/plugins/lockToVotePlugin/components/lockToVoteSetupGovernance/lockToVoteSetupGovernance.tsx",
                "!src/plugins/tokenPlugin/components/tokenSetupGovernance/tokenSetupGovernance.tsx",
                "!src/plugins/safeMultisigPlugin/components/safeMultisigSubmitVote/safeMultisigSubmitVote.tsx",
                "!src/shared/components/banner/banner.tsx",
                "!src/shared/components/container/container.tsx",
                "!src/shared/components/forms/addressesInput/addressesInputItem/addressesInputItem.tsx",
                "!src/shared/components/forms/autocompleteInput/autocompleteInputItem.tsx",
                "!src/shared/components/forms/autocompleteInput/autocompleteInputMenu.tsx",
                "!src/shared/components/navigation/navigationTrigger/navigationTrigger.tsx",
                "!src/shared/components/page/pageContent/pageContent.tsx",
                "!src/shared/components/page/pageHeader/pageHeader.tsx",
                "!src/shared/components/page/pageMain/pageMain.tsx",
                "!src/shared/components/transactionStatus/transactionStatusStep/transactionStatusStep.tsx",
                "!src/shared/components/wizardDetailsDialog/wizardDetailsDialog.tsx"
            ]
        },
        {
            "path": "../../packages/gov-ui-kit/biome-plugins/primitive-spacing.css.warn.grit",
            "resolutionKind": "config",
            "includes": [
                "!src/daos/aragonDemo/components/aragonDemoPageHeader/aragonDemoPageHeader.tsx",
                "!src/daos/aragonDemoPolicies/components/aragonDemoPoliciesPageHeader/aragonDemoPoliciesPageHeader.tsx",
                "!src/daos/boundless/components/boundlessPageHeader/boundlessAvatarIcon.tsx",
                "!src/daos/boundless/components/boundlessPageHeader/boundlessPageHeader.tsx",
                "!src/daos/cryptex/components/cryptexPageHeader/cryptexPageHeader.tsx",
                "!src/modules/application/components/debugPanel/debugPanel.tsx",
                "!src/modules/application/components/debugPanel/workspaceRegistryControls.tsx",
                "!src/modules/application/components/navigations/navigationDao/navigationDaoHome.tsx",
                "!src/modules/application/components/navigations/navigationSidebarAccount/navigationSidebarAccount.tsx",
                "!src/modules/application/components/navigations/navigationWizard/navigationWizard.tsx",
