{
    "name": "aragon-monorepo",
    "private": true,
    "description": "Aragon App monorepo",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/aragon/app.git"
    },
    "license": "GPL-3.0",
    "scripts": {
        "build": "turbo run build",
        "coverage:report": "node scripts/report-coverage.mjs",
        "css:check": "turbo run css:check",
        "dev": "turbo run dev",
        "postinstall": "node scripts/sync-skills.mjs --soft",
        "lint": "turbo run lint",
        "lint:check": "turbo run lint:check",
        "prepare": "husky",
        "skills:sync": "node scripts/sync-skills.mjs",
        "test": "pnpm validate:changesets && pnpm test:changesets && pnpm test:tokens && turbo run test",
        "test:changed": "turbo run test:changed",
        "test:changesets": "node --test '.github/workflows/scripts/*.test.js'",
        "test:coverage": "pnpm validate:changesets && pnpm test:changesets && pnpm test:tokens && turbo run test:coverage && pnpm coverage:report",
        "test:guardrails": "node --test .agents/shared/hooks/*.test.mjs .claude/shared/hooks/*.test.mjs",
        "test:hooks": "pnpm test:guardrails && pnpm test:skills",
        "test:skills": "node --test scripts/sync-skills.test.mjs",
        "test:tokens": "node --test .design-sync/tokens/validate.test.mjs .design-sync/tokens/generate.test.mjs .design-sync/consumer-parity.test.mjs",
        "tokens:generate": "node .design-sync/tokens/generate.mjs",
        "tokens:validate": "node .design-sync/tokens/validate.mjs",
        "type-check": "turbo run type-check",
        "validate:changesets": "node .github/workflows/scripts/validateChangesets.js"
    },
    "devDependencies": {
        "@biomejs/biome": "catalog:",
        "@changesets/changelog-github": "catalog:",
        "@changesets/cli": "catalog:",
        "ajv": "catalog:",
        "husky": "catalog:",
        "istanbul-lib-coverage": "^3.2.2",
        "lint-staged": "catalog:",
        "nyc": "^18.0.0",
        "skills": "1.5.20",
        "turbo": "catalog:",
        "ultracite": "catalog:",
        "vercel": "catalog:",
        "yaml": "catalog:"
    },
    "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
    "engines": {
        "node": ">=24.22.3"
    }
}
