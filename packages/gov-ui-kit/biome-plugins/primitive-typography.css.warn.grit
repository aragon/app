// Flags primitive type classes (@apply lines).
language css

or { TwApplyAtRule() } as $node where {
    $node <: r"(?s).*(?:^|[\s'\x22\x60{])(?:[\w\-\[\]&>:.*/()=,#%@'\x22]*:)?!?(?:text-(?:xs|sm|base|lg|xl|[2-9]xl)(?:/[\w.\[\]-]+)?|text-\[(?:\d|\.\d|clamp|calc|length:)[^\]\s]*\]|leading-[\w.\[\]-]+|font-(?:thin|extralight|light|normal|medium|semibold|bold|extrabold|black)|tracking-[\w.\[\]-]+)!?(?:[\s'\x22\x60}]|$).*",
