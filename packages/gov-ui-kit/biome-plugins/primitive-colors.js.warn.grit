} as $node where {
    $node <: r"(?s).*(?:^|[^\w-])(?:[a-z]+(?:-[a-z]+)*-(?:critical|info|neutral|primary|success|warning)-(?:0|25|50|100|200|300|400|500|600|700|800|900)(?:/[\w.%\[\]]+)?|--color-(?:critical|info|neutral|primary|success|warning)-(?:0|25|50|100|200|300|400|500|600|700|800|900)|shadow-critical|shadow-critical-lg|shadow-critical-md|shadow-critical-xl|shadow-info|shadow-info-lg|shadow-info-md|shadow-info-xl|shadow-neutral|shadow-neutral-2xl|shadow-neutral-lg|shadow-neutral-md|shadow-neutral-sm|shadow-neutral-xl|shadow-primary|shadow-primary-2xl|shadow-primary-lg|shadow-primary-md|shadow-primary-sm|shadow-primary-xl|shadow-success|shadow-success-lg|shadow-success-md|shadow-success-xl|shadow-warning|shadow-warning-lg|shadow-warning-md|shadow-warning-xl|ring-critical|ring-primary|ring-success|ring-warning|focus-ring-critical|focus-ring-primary|focus-ring-success|focus-ring-warning|gradient-neutral-50-transparent-to-b|gradient-neutral-50-transparent-to-t)(?:[^\w-]|$).*",
