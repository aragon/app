{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    // Shared rules and formatting come from the root biome.json; only the kit's own policy lives here.
    "root": false,
    "extends": "//",
    "formatter": {
        // The kit keeps the 120-column lines of its standalone repo.
        "lineWidth": 120
    },
    "linter": {
        "rules": {
            "nursery": {
                "useSortedClasses": {
                    "fix": "safe",
                    "level": "error",
                    "options": {
                        "attributes": [
                            "className"
                        ],
                        "functions": [
                            "classNames",
                            "clsx",
                            "cva",
                            "tw",
                            "twMerge",
                            "cn",
                            "twJoin",
                            "tv"
                        ]
                    }
                }
            },
            "performance": {
                // Component library rendered by any React host, not only Next.
                "noImgElement": "off"
            },
            "suspicious": {
                // 25 public components still take refs through forwardRef; migrating them is a separate change.
                "noReactForwardRef": "off"
            }
        }
    },
    "overrides": [
        {
            "includes": [
                "scripts/**"
            ],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noConsole": "off"
                    }
                }
            }
        },
        {
            "includes": [
                "**/*.test.ts",
                "**/*.test.tsx"
            ],
            "linter": {
                "rules": {
                    "correctness": {
                        "noPrecisionLoss": "off"
                    }
                }
            }
        },
        {
            "includes": [
                "**/*.stories.tsx",
                "**/*StoryComponent.tsx"
            ],
            "linter": {
                "rules": {
                    "correctness": {
                        "useHookAtTopLevel": "off"
                    },
                    "suspicious": {
                        "noArrayIndexKey": "off"
                    }
                }
            }
        }
    ]
}
