{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    // Shared rules and formatting come from the root biome.json; only the kit's own policy lives here.
    "root": false,
    "extends": "//",
    "formatter": {
        // The kit keeps the 120-column lines of its standalone repo.
        "lineWidth": 120
    },
    "linter": {
        "rules": {
            "performance": {
                // Component library rendered by any React host, not only Next.
                "noImgElement": "off"
            },
            "suspicious": {
                // 25 public components still take refs through forwardRef; migrating them is a separate change.
                "noReactForwardRef": "off",
                // Biome compares nested selectors across separate Tailwind @utility blocks.
                "noDuplicateSelectors": "off"
            }
        }
    },
    "overrides": [
        {
            // Token lint: source outside the theme takes role classes, not primitive ones. A token layer is one
            // biome-plugins/<language>/<rule>.grit per language, listed here and in apps/app/biome.jsonc. A class kept
            // on purpose gets `biome-ignore lint/plugin/<rule>: <reason>` on the line above it.
            "includes": [
                "src/**",
                "!src/theme/**",
                "!**/*.test.ts",
                "!**/*.test.tsx",
                "!**/*.stories.tsx",
                "!**/*StoryComponent.tsx",
                "!src/core/test/**",
                "!src/modules/testUtils/**"
            ],
            "plugins": [
                {
                    "path": "./biome-plugins/js/noPrimitiveColors.grit",
                    "resolutionKind": "config"
                },
                {
                    "path": "./biome-plugins/css/noPrimitiveColors.grit",
                    "resolutionKind": "config"
                }
            ]
        },
        {
            "includes": [
                "scripts/**"
            ],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noConsole": "off"
                    }
                }
            }
        },
        {
            "includes": [
                "**/*.test.ts",
                "**/*.test.tsx"
            ],
            "linter": {
                "rules": {
                    "correctness": {
                        "noPrecisionLoss": "off"
                    }
                }
            }
        },
        {
            "includes": [
                "**/*.stories.tsx",
                "**/*StoryComponent.tsx"
            ],
            "linter": {
                "rules": {
                    "correctness": {
                        "noComponentHookFactories": "off",
                        "useHookAtTopLevel": "off"
                    },
                    "suspicious": {
                        "noArrayIndexKey": "off"
                    }
                }
            }
        }
    ]
}
