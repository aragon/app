{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    // Shared rules and formatting come from the root biome.json; only the kit's own policy lives here.
    "root": false,
    "extends": "//",
    "formatter": {
        // The kit keeps the 120-column lines of its standalone repo.
        "lineWidth": 120
    },
    // Primitive type classes (text-sm, md:text-lg, leading-*, font-semibold, font-medium, tracking-*, text-[…px]):
    // text takes a typography role (src/theme/tokens/typography.css). The .grit files are generated
    // (`pnpm lint:typography:generate`). Production code is at zero findings, so it is an error everywhere; stories only
    // warn. To relax a folder while it migrates, move its glob to the `warn` plugin of each language and negate it
    // ("!…") in the `error` plugin; `pnpm lint:typography:check` verifies the scopes stay disjoint and that the
    // allowlisted files (component-owned glyph sizes, listed with their allowed classes in
    // scripts/primitive-typography.mjs) hold nothing else. `pnpm lint:typography:report` lists the findings per folder.
    "plugins": [
        {
            "path": "./biome-plugins/primitive-typography.js.warn.grit",
            "resolutionKind": "config",
            "includes": [
                "src/**/*.stories.tsx",
                "!src/core/components/avatars/avatar/avatar.tsx",
                "!src/core/components/avatars/avatarStack/avatarStack.tsx",
                "!src/modules/components/dao/daoAvatar/daoAvatar.tsx"
            ]
        },
        {
            "path": "./biome-plugins/primitive-typography.js.error.grit",
            "resolutionKind": "config",
            "includes": [
                "src/**/*.ts",
                "src/**/*.tsx",
                "!src/theme/tokens/**",
                "!**/*.test.ts",
                "!**/*.test.tsx",
                "!src/**/*.stories.tsx",
                "!src/core/components/avatars/avatar/avatar.tsx",
                "!src/core/components/avatars/avatarStack/avatarStack.tsx",
                "!src/modules/components/dao/daoAvatar/daoAvatar.tsx"
            ]
        },
        {
            "path": "./biome-plugins/primitive-typography.css.warn.grit",
            "resolutionKind": "config",
            "includes": [
                "!src/core/components/avatars/avatar/avatar.tsx",
                "!src/core/components/avatars/avatarStack/avatarStack.tsx",
                "!src/modules/components/dao/daoAvatar/daoAvatar.tsx"
            ]
        },
        {
            "path": "./biome-plugins/primitive-typography.css.error.grit",
            "resolutionKind": "config",
            "includes": [
                "src/**/*.css",
                "!src/theme/tokens/**",
                "!src/core/components/avatars/avatar/avatar.tsx",
                "!src/core/components/avatars/avatarStack/avatarStack.tsx",
                "!src/modules/components/dao/daoAvatar/daoAvatar.tsx"
            ]
        }
    ],
    "linter": {
        "rules": {
            "performance": {
                // Component library rendered by any React host, not only Next.
                "noImgElement": "off"
            },
            "suspicious": {
                // 25 public components still take refs through forwardRef; migrating them is a separate change.
                "noReactForwardRef": "off",
                // Biome compares nested selectors across separate Tailwind @utility blocks.
                "noDuplicateSelectors": "off"
            }
        }
    },
    "overrides": [
        {
            "includes": [
                "scripts/**"
            ],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noConsole": "off"
                    }
                }
            }
        },
        {
            "includes": [
                "**/*.test.ts",
                "**/*.test.tsx"
            ],
            "linter": {
                "rules": {
                    "correctness": {
                        "noPrecisionLoss": "off"
                    }
                }
            }
        },
        {
            "includes": [
                "**/*.stories.tsx",
                "**/*StoryComponent.tsx"
            ],
            "linter": {
                "rules": {
                    "correctness": {
                        "noComponentHookFactories": "off",
                        "useHookAtTopLevel": "off"
                    },
                    "suspicious": {
                        "noArrayIndexKey": "off"
                    }
                }
            }
        }
    ]
}
