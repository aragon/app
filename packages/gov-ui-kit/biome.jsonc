{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    // Shared rules and formatting come from the root biome.json; only the kit's own policy lives here.
    "root": false,
    "extends": "//",
    "formatter": {
        // The kit keeps the 120-column lines of its standalone repo.
        "lineWidth": 120
    },
    // Raw spacing classes (p-4, md:gap-3, -mt-2, pt-[72px], space-y-6): padding, margin, gap and space take a spacing
    // role, a component size or a documented <family>-<role>--<pattern> exception (src/theme/tokens/spacing.css). The
    // .grit files are generated (`pnpm lint:spacing:generate`). Production code is at zero findings, so it is an error
    // everywhere; stories only warn. Zero values and auto margins are not flagged. The allowlisted files (geometry,
    // budget outliers and devtools, each listed with its allowed classes and reason in scripts/primitive-spacing.mjs)
    // are left out of both scopes; `pnpm lint:spacing:check` verifies the plugins, the scopes and the allowlist, and
    // `pnpm lint:spacing:report` lists the findings per folder.
    // Primitive palette colour classes (bg-primary-400, shadow-neutral-md, focus-ring-primary, var(--color-…)) while
    // components move to the semantic colour layer. The .grit files are generated (`pnpm lint:colors:generate`).
    // To make a migrated folder strict, add its glob to the `error` plugin of each language AND add the same glob
    // negated ("!…") to the matching `warn` plugin; `pnpm lint:colors:check` verifies the scopes stay disjoint.
    // `pnpm lint:colors:report` prints the remaining findings per component folder.
    "plugins": [
        {
            "path": "./biome-plugins/primitive-spacing.js.warn.grit",
            "resolutionKind": "config",
            "includes": [
                "src/**/*.stories.tsx",
                "!src/core/components/avatars/avatarStack/avatarStack.tsx",
                "!src/core/components/dialogs/dialog/dialogHeader/dialogHeader.tsx",
                "!src/core/components/dataList/dataListFilter/dataListFilter.tsx",
                "!src/core/components/forms/inputFileAvatar/inputFileAvatar.tsx",
                "!src/core/components/forms/switch/switch.tsx",
                "!src/core/components/forms/checkboxCard/checkboxCard.tsx",
                "!src/core/components/forms/radioCard/radioCard.tsx",
                "!src/core/components/states/emptyState/emptyState.tsx",
                "!src/modules/components/wallet/wallet.tsx",
                "!src/modules/components/proposal/proposalActions/proposalActionsDecoder/proposalActionsDecoderField/proposalActionsDecoderField.tsx",
                "!src/theme/utils/prose.css"
            ]
        },
        {
            "path": "./biome-plugins/primitive-spacing.js.error.grit",
            "resolutionKind": "config",
            "includes": [
                "src/**/*.ts",
                "src/**/*.tsx",
                "!src/theme/tokens/**",
                "!**/*.test.ts",
                "!**/*.test.tsx",
                "!src/**/*.stories.tsx",
                "!src/core/components/avatars/avatarStack/avatarStack.tsx",
                "!src/core/components/dialogs/dialog/dialogHeader/dialogHeader.tsx",
                "!src/core/components/dataList/dataListFilter/dataListFilter.tsx",
                "!src/core/components/forms/inputFileAvatar/inputFileAvatar.tsx",
                "!src/core/components/forms/switch/switch.tsx",
                "!src/core/components/forms/checkboxCard/checkboxCard.tsx",
                "!src/core/components/forms/radioCard/radioCard.tsx",
                "!src/core/components/states/emptyState/emptyState.tsx",
                "!src/modules/components/wallet/wallet.tsx",
                "!src/modules/components/proposal/proposalActions/proposalActionsDecoder/proposalActionsDecoderField/proposalActionsDecoderField.tsx",
                "!src/theme/utils/prose.css"
            ]
        },
        {
            "path": "./biome-plugins/primitive-spacing.css.warn.grit",
            "resolutionKind": "config",
            "includes": [
                "!src/core/components/avatars/avatarStack/avatarStack.tsx",
                "!src/core/components/dialogs/dialog/dialogHeader/dialogHeader.tsx",
                "!src/core/components/dataList/dataListFilter/dataListFilter.tsx",
                "!src/core/components/forms/inputFileAvatar/inputFileAvatar.tsx",
                "!src/core/components/forms/switch/switch.tsx",
                "!src/core/components/forms/checkboxCard/checkboxCard.tsx",
                "!src/core/components/forms/radioCard/radioCard.tsx",
                "!src/core/components/states/emptyState/emptyState.tsx",
                "!src/modules/components/wallet/wallet.tsx",
                "!src/modules/components/proposal/proposalActions/proposalActionsDecoder/proposalActionsDecoderField/proposalActionsDecoderField.tsx",
                "!src/theme/utils/prose.css"
            ]
        },
        {
            "path": "./biome-plugins/primitive-spacing.css.error.grit",
            "resolutionKind": "config",
            "includes": [
                "src/**/*.css",
                "!src/theme/tokens/**",
                "!src/core/components/avatars/avatarStack/avatarStack.tsx",
                "!src/core/components/dialogs/dialog/dialogHeader/dialogHeader.tsx",
                "!src/core/components/dataList/dataListFilter/dataListFilter.tsx",
                "!src/core/components/forms/inputFileAvatar/inputFileAvatar.tsx",
                "!src/core/components/forms/switch/switch.tsx",
                "!src/core/components/forms/checkboxCard/checkboxCard.tsx",
                "!src/core/components/forms/radioCard/radioCard.tsx",
                "!src/core/components/states/emptyState/emptyState.tsx",
                "!src/modules/components/wallet/wallet.tsx",
                "!src/modules/components/proposal/proposalActions/proposalActionsDecoder/proposalActionsDecoderField/proposalActionsDecoderField.tsx",
                "!src/theme/utils/prose.css"
            ]
        },
        {
            "path": "./biome-plugins/primitive-colors.js.warn.grit",
            "resolutionKind": "config",
            "includes": [
                "src/**/*.ts",
                "src/**/*.tsx",
                "!src/theme/**",
                "!**/*.test.ts",
                "!**/*.test.tsx",
                "!**/*.stories.tsx",
                "!**/*StoryComponent.tsx",
                "!src/core/test/**",
                "!src/modules/testUtils/**",
                "!src/core/components/button/**",
                "!src/core/components/addressOutput/**",
                "!src/core/components/alerts/**",
                "!src/core/components/cards/**",
                "!src/core/components/clipboard/**",
                "!src/core/components/definitionList/**",
                "!src/core/components/documentParser/**",
                "!src/core/components/gukCoreProvider/**",
                "!src/core/components/heading/**",
                "!src/core/components/icon/**",
                "!src/core/components/link/**",
                "!src/core/components/progress/**",
                "!src/core/components/rerender/**",
                "!src/core/components/tag/**",
                "!src/modules/components/action/**",
                "!src/modules/components/addressInput/**",
                "!src/modules/components/dao/**",
                "!src/modules/components/gukModulesProvider/**",
                "!src/modules/components/member/**",
                "!src/modules/components/proposal/**",
                "!src/modules/components/smartContract/**",
                "!src/modules/components/vote/**",
                "!src/core/components/accordion/**",
                "!src/core/components/avatars/**",
                "!src/core/components/collapsible/**",
                "!src/core/components/dialogs/**",
                "!src/core/components/dropdown/**",
                "!src/core/components/states/**",
                "!src/core/components/toggles/**",
                "!src/modules/components/asset/**",
                "!src/modules/components/wallet/**"
            ]
        },
        {
            "path": "./biome-plugins/primitive-colors.js.error.grit",
            "resolutionKind": "config",
            "includes": [
                "src/core/components/button/**",
                "src/core/components/addressOutput/**",
                "src/core/components/alerts/**",
                "src/core/components/cards/**",
                "src/core/components/clipboard/**",
                "src/core/components/definitionList/**",
                "src/core/components/documentParser/**",
                "src/core/components/gukCoreProvider/**",
                "src/core/components/heading/**",
                "src/core/components/icon/**",
                "src/core/components/link/**",
                "src/core/components/progress/**",
                "src/core/components/rerender/**",
                "src/core/components/tag/**",
                "src/modules/components/action/**",
                "src/modules/components/addressInput/**",
                "src/modules/components/dao/**",
                "src/modules/components/gukModulesProvider/**",
                "src/modules/components/member/**",
                "src/modules/components/proposal/**",
                "src/modules/components/smartContract/**",
                "src/modules/components/vote/**",
                "src/core/components/accordion/**",
                "src/core/components/avatars/**",
                "src/core/components/collapsible/**",
                "src/core/components/dialogs/**",
                "src/core/components/dropdown/**",
                "src/core/components/states/**",
                "src/core/components/toggles/**",
                "src/modules/components/asset/**",
                "src/modules/components/wallet/**",
                "!**/*.test.ts",
                "!**/*.test.tsx",
                "!**/*.stories.tsx",
                "!**/*StoryComponent.tsx"
            ]
        },
        {
            "path": "./biome-plugins/primitive-colors.css.warn.grit",
            "resolutionKind": "config",
            "includes": [
                "src/**/*.css",
                "!src/theme/**",
                "!src/core/components/button/**",
                "!src/core/components/addressOutput/**",
                "!src/core/components/alerts/**",
                "!src/core/components/cards/**",
                "!src/core/components/clipboard/**",
                "!src/core/components/definitionList/**",
                "!src/core/components/documentParser/**",
                "!src/core/components/gukCoreProvider/**",
                "!src/core/components/heading/**",
                "!src/core/components/icon/**",
                "!src/core/components/link/**",
                "!src/core/components/progress/**",
                "!src/core/components/rerender/**",
                "!src/core/components/tag/**",
                "!src/modules/components/action/**",
                "!src/modules/components/addressInput/**",
                "!src/modules/components/dao/**",
                "!src/modules/components/gukModulesProvider/**",
                "!src/modules/components/member/**",
                "!src/modules/components/proposal/**",
                "!src/modules/components/smartContract/**",
                "!src/modules/components/vote/**",
                "!src/core/components/accordion/**",
                "!src/core/components/avatars/**",
                "!src/core/components/collapsible/**",
                "!src/core/components/dialogs/**",
                "!src/core/components/dropdown/**",
                "!src/core/components/states/**",
                "!src/core/components/toggles/**",
                "!src/modules/components/asset/**",
                "!src/modules/components/wallet/**"
            ]
        },
        {
            "path": "./biome-plugins/primitive-colors.css.error.grit",
            "resolutionKind": "config",
            "includes": [
                "src/core/components/button/**",
                "src/core/components/addressOutput/**",
                "src/core/components/alerts/**",
                "src/core/components/cards/**",
                "src/core/components/clipboard/**",
                "src/core/components/definitionList/**",
                "src/core/components/documentParser/**",
                "src/core/components/gukCoreProvider/**",
                "src/core/components/heading/**",
                "src/core/components/icon/**",
                "src/core/components/link/**",
                "src/core/components/progress/**",
                "src/core/components/rerender/**",
                "src/core/components/tag/**",
                "src/modules/components/action/**",
                "src/modules/components/addressInput/**",
                "src/modules/components/dao/**",
                "src/modules/components/gukModulesProvider/**",
                "src/modules/components/member/**",
                "src/modules/components/proposal/**",
                "src/modules/components/smartContract/**",
                "src/modules/components/vote/**",
                "src/core/components/accordion/**",
                "src/core/components/avatars/**",
                "src/core/components/collapsible/**",
                "src/core/components/dialogs/**",
                "src/core/components/dropdown/**",
                "src/core/components/states/**",
                "src/core/components/toggles/**",
                "src/modules/components/asset/**",
                "src/modules/components/wallet/**"
            ]
        }
    ],
    "linter": {
        "rules": {
            "performance": {
                // Component library rendered by any React host, not only Next.
                "noImgElement": "off"
            },
            "suspicious": {
                // 25 public components still take refs through forwardRef; migrating them is a separate change.
                "noReactForwardRef": "off",
                // Biome compares nested selectors across separate Tailwind @utility blocks.
                "noDuplicateSelectors": "off"
            }
        }
    },
    "overrides": [
        {
            "includes": [
                "scripts/**"
            ],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noConsole": "off"
                    }
                }
            }
        },
        {
            "includes": [
                "**/*.test.ts",
                "**/*.test.tsx"
            ],
            "linter": {
                "rules": {
                    "correctness": {
                        "noPrecisionLoss": "off"
                    }
                }
            }
        },
        {
            "includes": [
                "**/*.stories.tsx",
                "**/*StoryComponent.tsx"
            ],
            "linter": {
                "rules": {
                    "correctness": {
                        "noComponentHookFactories": "off",
                        "useHookAtTopLevel": "off"
                    },
                    "suspicious": {
                        "noArrayIndexKey": "off"
                    }
                }
            }
        }
    ]
}
