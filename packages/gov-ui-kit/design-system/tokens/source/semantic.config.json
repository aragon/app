    "utilities": {
        "$description": "Extra utility families, generated for every token of the named families (Tailwind emits only the classes a source uses). Naming (P-41): single-side borders keep Tailwind's grammar, the side replacing the family (`border-t-accent-secondary` applies border/accent/secondary to the top side); every other applier is followed by the full token class (`from-gradient-surface-primary`, `fill-bg-surface-tertiary-inverse`, `caret-text-surface-secondary`), so the Figma token name stays readable in the class. Fades: `<gradient token>-to-<direction>` paints a gradient token to its `-transparent` twin (the semantic counterpart of the kit's `gradient-neutral-50-transparent-to-b`). `alphaStops` are the few stops that need a fixed opacity of a token, named like Tailwind's opacity modifier. `crossFamily` applies a token to a property of another family where the designer bound it so; each entry is a provisional decision (P-42) with its reason.",
        "borderSides": [
            "t",
            "r",
            "b",
            "l",
            "x",
            "y"
        ],
        "appliers": [
            {
                "applier": "from",
                "families": [
                    "gradient"
                ]
            },
            {
                "applier": "via",
                "families": [
                    "gradient"
                ]
            },
            {
                "applier": "to",
                "families": [
                    "gradient"
                ]
            },
            {
                "applier": "fill",
                "families": [
                    "bg",
                    "icon"
                ]
            },
            {
                "applier": "stroke",
                "families": [
                    "border",
                    "icon"
                ]
            },
            {
                "applier": "caret",
                "families": [
                    "text"
                ]
            }
        ],
        "fadeDirections": [
            "t",
            "r",
            "b",
            "l"
        ],
        "alphaStops": [
            {
                "applier": "via",
                "token": "gradient/surface/secondary",
                "alpha": 70,
                "note": "The collapsible's overflow fade has a 70 % middle stop today (via-neutral-0/70); Figma draws it with two stops (gradient/surface/secondary-transparent > secondary). Kept as today (O-01); the middle stop is listed for the designer."
            }
        ],
        "crossFamily": [
            {
                "applier": "bg",
                "token": "icon/surface/secondary",
                "note": "Switch thumb, unchecked and checked + disabled: Figma fills the handle with icon/surface/secondary (G-17). Same colour today (neutral-300)."
            },
            {
                "applier": "bg",
                "token": "icon/accent/primary",
                "note": "Switch thumb, checked: Figma fills the handle with icon/accent/primary (G-17). Same colour today (primary-400)."
            },
            {
                "applier": "border",
                "token": "bg/surface/primary",
                "note": "Progress threshold marker outline: Figma strokes it with bg/surface/primary, the card surface the marker is cut out of (G-17). Same colour today (neutral-0)."
            },
            {
                "applier": "border-b",
                "token": "bg/surface/primary",
                "note": "ProposalVotingProgress container in a row: the items keep their 1px bottom border, painted in the card's own surface colour to hide it (today border-b-neutral-0 on a neutral-0 card). Code-only: Figma has no bottom divider in the row layout."
            },
            {
                "applier": "caret",
                "token": "bg/surface/secondary-inverse",
                "note": "Text-input caret: Figma draws it as a fill bound to bg/surface/secondary-inverse in every input focus state (G-07, G-17); the data-list filter's caret binds text/surface/secondary instead (G-18). Each follows its binding (P-28)."
            },
            {
                "applier": "shadow",
                "token": "border/surface/selected",
                "note": "Tab trigger underline: Figma draws it as a border bound to border/surface/selected; the code draws it with a box-shadow, so the token is applied as the shadow colour. Same colour today (primary-400)."
            },
            {
                "applier": "shadow",
                "token": "border/surface/hover-tab",
                "note": "Underlined tab, hover: the underline is drawn with a box-shadow in code; the alias (P-66) keeps today's neutral-800 and follows border/surface/hover, the Figma binding, in \"next\" and \"dark\" (A-22)."
            }
        ]
    },
    "primitiveRemap": {
        "$description": "Palette-change preview (L-01) in the \"next\" value set only: every primitive colour variable (--color-<ramp>-<step>, the variables behind the primitive classes such as bg-neutral-50 and text-critical-600) is redeclared under [data-theme=\"next\"] as the same step of the corresponding Figma ramp, so markup that still uses primitive classes follows the new palette in \"next\". The ramp correspondence is the one of `semantic-colors.parity.json` `fallbackRamps`, read in reverse (neutral -> gray, primary -> aragon, success -> green, warning -> orange, critical -> red, info -> blue). A step the Figma ramp lacks takes the nearest one; `steps` decides the ties (the generator fails on an undecided tie). The default theme and \"dark\" are not touched; dark is not remapped on purpose (P-55). Not a semantic conversion: the classes keep their step, only the palette under them changes (P-54).",
        "steps": {
            "neutral-25": "gray/50"
        }
    }
}
