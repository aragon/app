{
    "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
    "$description": "Typography, Today mode: what every role and exception renders in the default theme (the code renders exactly this). fontFamily and letterSpacing are inherited today (typography.config.json todayInherits), so they state the inherited defaults.",
    "type": {
        "$type": "typography",
        "role": {
            "display": {
                "$description": "The one statement a landing screen leads with; never more than one per screen.",
                "base": {
                    "$value": {
                        "fontFamily": "{font.family.sans}",
                        "fontSize": "{font.size.3xl}",
                        "fontWeight": "{font.weight.normal}",
                        "letterSpacing": {
                            "value": 0,
                            "unit": "px"
                        },
                        "lineHeight": "{font.leading.tight}"
                    }
                },
                "md": {
                    "$value": {
                        "fontFamily": "{font.family.sans}",
                        "fontSize": "{font.size.5xl}",
                        "fontWeight": "{font.weight.normal}",
                        "letterSpacing": {
                            "value": 0,
                            "unit": "px"
                        },
                        "lineHeight": "{font.leading.tight}"
                    }
                }
            },
