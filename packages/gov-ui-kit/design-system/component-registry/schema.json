{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://aragon.org/gov-ui-kit/component-registry/schema.json",
    "title": "GovKit component registry",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schemaVersion",
        "provenance",
        "components"
    ],
    "properties": {
        "schemaVersion": {
            "type": "string",
            "const": "2.0.0"
        },
        "provenance": {
            "$ref": "#/$defs/provenance"
        },
        "components": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/component"
            }
        }
    },
    "$defs": {
        "ref": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "repository",
                "path",
                "line",
                "sha256"
            ],
            "properties": {
                "repository": {
                    "type": "string",
                    "enum": [
                        "kit"
                    ]
                },
                "path": {
                    "type": "string",
                    "minLength": 1
                },
                "line": {
                    "type": "integer",
                    "minimum": 1
                },
                "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                }
            }
        },
        "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "sourceRoots",
                "kit"
            ],
            "properties": {
                "sourceRoots": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "kit"
                    ],
                    "properties": {
                        "kit": {
                            "type": "string"
                        }
                    }
                },
                "kit": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "root",
                        "commit",
                        "dirty",
                        "sourceVersion",
                        "entrypoints"
                    ],
                    "properties": {
                        "root": {
                            "type": "string",
                            "const": "kit"
                        },
                        "commit": {
                            "anyOf": [
                                {
                                    "type": "string",
                                    "pattern": "^[a-f0-9]{40}$"
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        },
                        "dirty": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "sourceVersion": {
                            "type": "string"
                        },
                        "entrypoints": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "js",
                                "css"
                            ],
                            "properties": {
                                "js": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                },
                                "css": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "member": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "name",
                "exportNames",
                "source",
                "props",
                "stories",
                "tests",
                "docs"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^govkit:.+"
                },
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "exportNames": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "source": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/ref"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "props": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/ref"
                    }
                },
                "stories": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/ref"
                    }
                },
                "tests": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/ref"
                    }
                },
                "docs": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/ref"
                    }
                }
            }
        },
        "exportEntry": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "entrypoint",
                "name",
                "isAlias"
            ],
            "properties": {
                "entrypoint": {
                    "type": "string",
                    "minLength": 1
                },
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "isAlias": {
                    "type": "boolean"
                }
            }
        },
        "intent": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "description",
                "useWhen",
                "constraints",
                "related",
                "ownership",
                "evidence",
                "evidenceStatus",
                "review",
                "stale"
            ],
            "properties": {
                "description": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "useWhen": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "keyProps": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "name",
                            "contract"
                        ],
                        "properties": {
                            "name": {
                                "type": "string",
                                "minLength": 1
                            },
                            "contract": {
                                "type": "string",
                                "minLength": 1
                            }
                        }
                    }
                },
                "alternatives": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "id",
                            "useWhen"
                        ],
                        "properties": {
                            "id": {
                                "type": "string",
                                "pattern": "^govkit:[A-Za-z0-9_.]+$"
                            },
                            "useWhen": {
                                "type": "string",
                                "minLength": 1
                            }
                        }
                    }
                },
                "composition": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "methods": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "name",
                            "contract"
                        ],
                        "properties": {
                            "name": {
                                "type": "string",
                                "minLength": 1
                            },
                            "contract": {
                                "type": "string",
                                "minLength": 1
                            }
                        }
                    }
                },
                "constraints": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "related": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "name",
                            "distinction"
                        ],
                        "properties": {
                            "name": {
                                "type": "string",
                                "minLength": 1
                            },
                            "distinction": {
                                "type": "string"
                            }
                        }
                    }
                },
                "ownership": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "package",
                        "domain",
                        "maintainer"
                    ],
                    "properties": {
                        "package": {
                            "type": "string",
                            "minLength": 1
                        },
                        "domain": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "maintainer": {
                            "type": [
                                "string",
                                "null"
                            ]
                        }
                    }
                },
                "evidence": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/ref"
                    }
                },
                "evidenceStatus": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "repository",
                            "path",
                            "status",
                            "expectedSha256",
                            "actualSha256"
                        ],
                        "properties": {
                            "repository": {
                                "type": "string",
                                "enum": [
                                    "kit"
                                ]
                            },
                            "path": {
                                "type": "string",
                                "minLength": 1
                            },
                            "status": {
                                "type": "string",
                                "enum": [
                                    "current",
                                    "changed",
                                    "missing"
                                ]
                            },
                            "expectedSha256": {
                                "type": "string",
                                "pattern": "^[a-f0-9]{64}$"
                            },
                            "actualSha256": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "pattern": "^[a-f0-9]{64}$"
                            }
                        }
                    }
                },
                "review": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "state",
                        "by",
                        "at"
                    ],
                    "properties": {
                        "state": {
                            "type": "string",
                            "enum": [
                                "unreviewed",
                                "human-reviewed"
                            ]
                        },
                        "by": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "at": {
                            "type": [
                                "string",
                                "null"
                            ]
                        }
                    }
                },
                "stale": {
                    "type": "boolean"
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "review": {
                                "properties": {
                                    "state": {
                                        "const": "human-reviewed"
                                    }
                                }
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "evidence": {
                                "minItems": 1
                            },
                            "review": {
                                "properties": {
                                    "by": {
                                        "type": "string",
                                        "minLength": 1
                                    },
                                    "at": {
                                        "type": "string",
                                        "minLength": 1
                                    }
                                }
                            }
                        }
                    }
                }
            ]
        },
        "component": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "name",
                "kind",
                "exportNames",
                "exports",
                "members",
                "source",
                "props",
                "stories",
                "tests",
                "docs",
                "intent"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^govkit:.+"
                },
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "kind": {
                    "type": "string",
                    "enum": [
                        "component",
                        "compound",
                        "utility",
                        "non-component",
                        "css"
                    ]
                },
                "values": {
                    "description": "Allowed values of an exported enum (member names) or string-literal union type (quoted literals), in declaration order.",
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "usageNotes": {
                    "description": "Bullets under \"Usage notes:\" in the declaration's JSDoc.",
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "exportNames": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "exports": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/exportEntry"
                    }
                },
                "members": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/member"
                    }
                },
                "source": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/ref"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "props": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/ref"
                    }
                },
                "stories": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/ref"
                    }
                },
                "tests": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/ref"
                    }
                },
                "docs": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/ref"
                    }
                },
                "intent": {
                    "$ref": "#/$defs/intent"
                }
            }
        }
    }
}
