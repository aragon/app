@@ -0,0 +1,10 @@
+'use strict';
+// Loaded into every Node process of `next dev` when BASELINE_COVERAGE=1 (start.sh): SIGUSR2 writes this process's V8
+// coverage into NODE_V8_COVERAGE without stopping it.
+process.on('SIGUSR2', () => {
+    try {
+        require('node:v8').takeCoverage();
+    } catch {
+        // NODE_V8_COVERAGE not set: nothing to write.
+    }
+});
diff --git a/coverage-report.cjs b/coverage-report.cjs
new file mode 100644
index 0000000..f700195
--- /dev/null
+++ b/coverage-report.cjs
@@ -0,0 +1,90 @@
+'use strict';
+// Colour-class coverage report. Usage: node coverage-report.cjs <out dir> [<node v8 coverage dir>]
+// Combines the browser coverage written by the capture scripts (<out>/coverage/client-*.json) with the server's
+// NODE_V8_COVERAGE files, and lists every apps/app/src file (tests and stories excluded) that contains a primitive
+// colour class, as covered (a colour literal in code that executed, client or server) or not.
+const fs = require('node:fs');
+const path = require('node:path');
+const { REPO } = require('./lib.cjs');
+const { COLOR, analyse, merge } = require('./coverage.cjs');
+
+const [outDir, serverDir] = process.argv.slice(2);
+const SRC = path.join(REPO, 'apps', 'app', 'src');
+
+const client = {};
+const perJob = {};
+for (const f of fs.readdirSync(path.join(outDir, 'coverage'))) {
+    if (f.startsWith('client-')) {
+        const data = JSON.parse(fs.readFileSync(path.join(outDir, 'coverage', f), 'utf8'));
+        perJob[f.slice(7, -5)] = data;
+        merge(client, data);
+    }
+}
+const server = {};
+if (serverDir) {
+    const sources = new Map();
+    for (const f of fs.readdirSync(serverDir)) {
+        const { result } = JSON.parse(fs.readFileSync(path.join(serverDir, f), 'utf8'));
+        for (const script of result) {
+            if (!script.url.includes('/.next/dev/server/chunks/')) {
+                continue;
+            }
+            const file = new URL(script.url).pathname;
+            if (!sources.has(file)) {
+                sources.set(file, fs.existsSync(file) ? fs.readFileSync(file, 'utf8') : '');
+            }
+            merge(server, analyse(sources.get(file), script.functions));
+        }
+    }
+}
+
+const files = [];
+const walk = (dir) => {
+    for (const e of fs.readdirSync(dir, { withFileTypes: true })) {
+        const full = path.join(dir, e.name);
+        if (e.isDirectory()) {
+            walk(full);
+        } else if (/\.(tsx?|css)$/.test(e.name) && !/\.(test|stories)\.tsx?$/.test(e.name) && !full.includes('__mocks__')) {
+            const text = fs.readFileSync(full, 'utf8');
+            const n = text.match(COLOR)?.length ?? 0;
+            if (n > 0) {
+                files.push({ file: path.relative(SRC, full), n });
+            }
+        }
+    }
+};
+walk(SRC);
+
+const rows = files.map(({ file, n }) => {
+    const c = client[file]?.hit ?? 0;
+    const s = server[file]?.hit ?? 0;
+    const seen = file in client || file in server;
+    return { file, classes: n, client: c, server: s, covered: c > 0 || s > 0, loaded: seen };
+});
+const covered = rows.filter((r) => r.covered);
+const report = {
+    totalFiles: rows.length,
+    totalClasses: rows.reduce((a, r) => a + r.classes, 0),
+    coveredFiles: covered.length,
+    coveredClassesInCoveredFiles: covered.reduce((a, r) => a + r.classes, 0),
+    rows,
+    jobsPerFile: Object.fromEntries(
+        rows.map((r) => [r.file, Object.keys(perJob).filter((j) => (perJob[j][r.file]?.hit ?? 0) > 0)]),
+    ),
+};
+fs.writeFileSync(path.join(outDir, 'coverage-report.json'), JSON.stringify(report, null, 1));
+console.log(
+    `${report.coveredFiles}/${report.totalFiles} colour-bearing files covered (${report.coveredClassesInCoveredFiles}/${report.totalClasses} class occurrences in covered files)`,
+);
+const byModule = {};
+for (const r of rows.filter((x) => !x.covered)) {
+    const parts = r.file.split('/');
+    const mod = parts[0] === 'modules' || parts[0] === 'plugins' || parts[0] === 'actions' ? parts.slice(0, 2).join('/') : parts[0];
+    (byModule[mod] ??= []).push(`${r.file} (${r.classes}${r.loaded ? ', loaded, not executed' : ''})`);
+}
+for (const [mod, list] of Object.entries(byModule).sort()) {
+    console.log(`\n${mod}: ${list.length}`);
+    for (const l of list) {
+        console.log(`  ${l}`);
+    }
+}
diff --git a/coverage.cjs b/coverage.cjs
new file mode 100644
index 0000000..6622b11
--- /dev/null
+++ b/coverage.cjs
@@ -0,0 +1,106 @@
+'use strict';
+// Colour-class coverage (opt-in: BASELINE_COVERAGE=1). Records, per capture job, which apps/app/src modules had a
+// primitive colour class literal (e.g. "text-neutral-500") in code that actually executed in the browser, using
+// Chromium's precise (block) JS coverage on the Turbopack dev chunks. The server side is measured separately with
+// NODE_V8_COVERAGE (see coverage-report.cjs). Output: $BASELINE_OUT/coverage/client-<job>.json
+const fs = require('node:fs');
+const path = require('node:path');
+
+const ENABLED = process.env.BASELINE_COVERAGE === '1';
+const COLOR =
+    /(?:bg|text|border|ring|shadow|fill|stroke|from|to|via|divide|outline|decoration|caret)-(?:primary|neutral|info|success|warning|critical)-\d+/g;
+// A module definition in a Turbopack chunk: its key at the start of a line, followed by its factory. (References to
+// other modules inside a factory use the same key strings, but never at the start of a line followed by ", (".)
+const MODULE_KEY = /^"\[project\]\/apps\/app\/src\/([^" ]+) \[[^\]]+\] \([^)]*\)[^"]*", \(/gm;
+// Any module definition (app, packages, node_modules): where an app module's segment ends.
+const ANY_MODULE_KEY = /^"\[project\]\/[^"]+", \(/gm;
+
+// For one script: its source and V8 function ranges -> { file: {hit, total} } of colour literals per app module.
+const analyse = (source, functions) => {
+    const ranges = [];
+    for (const fn of functions) {
+        for (const r of fn.ranges) {
+            ranges.push(r);
+        }
+    }
+    const countAt = (offset) => {
+        // The innermost range that contains the offset decides (V8 block coverage semantics).
+        let best = null;
+        for (const r of ranges) {
+            if (r.startOffset <= offset && offset < r.endOffset) {
+                if (best == null || r.endOffset - r.startOffset <= best.endOffset - best.startOffset) {
+                    best = r;
+                }
+            }
+        }
+        return best ? best.count : 0;
+    };
+    const keys = [];
+    for (const m of source.matchAll(MODULE_KEY)) {
+        keys.push({ file: m[1], at: m.index });
+    }
+    const result = {};
+    for (let i = 0; i < keys.length; i++) {
+        const { file, at } = keys[i];
+        if (/\.(test|stories)\.tsx?$/.test(file)) {
+            continue;
+        }
+        ANY_MODULE_KEY.lastIndex = at + 1;
+        const end = ANY_MODULE_KEY.exec(source)?.index ?? source.length;
+        const segment = source.slice(at, end);
+        for (const m of segment.matchAll(COLOR)) {
+            const entry = (result[file] ??= { hit: 0, total: 0 });
+            entry.total++;
+            if (countAt(at + m.index) > 0) {
+                entry.hit++;
+            }
+        }
+    }
+    return result;
+};
+
+const merge = (into, from) => {
+    for (const [file, { hit, total }] of Object.entries(from)) {
+        const e = (into[file] ??= { hit: 0, total: 0 });
+        e.hit = Math.max(e.hit, hit);
+        e.total = Math.max(e.total, total);
+    }
+    return into;
+};
+
+// Wraps context.newPage so that every page records JS coverage from its first script on.
+const instrument = (context) => {
+    if (!ENABLED) {
+        return;
+    }
+    const newPage = context.newPage.bind(context);
+    context.coveragePages = [];
+    context.newPage = async (...args) => {
+        const page = await newPage(...args);
+        await page.coverage.startJSCoverage({ resetOnNavigation: false });
+        context.coveragePages.push(page);
+        return page;
+    };
+};
+
+// Collects the coverage of every instrumented page of a context (before it is closed) for a job.
+const collect = async (context, jobName, outDir) => {
+    if (!ENABLED || !context.coveragePages) {
+        return;
+    }
+    const acc = {};
+    for (const page of context.coveragePages) {
+        const entries = await page.coverage.stopJSCoverage().catch(() => []);
+        for (const entry of entries) {
+            if (!entry.url.includes('/_next/static/chunks/') || !entry.source) {
+                continue;
+            }
+            merge(acc, analyse(entry.source, entry.functions));
+        }
+    }
+    const dir = path.join(outDir, 'coverage');
+    fs.mkdirSync(dir, { recursive: true });
+    fs.writeFileSync(path.join(dir, `client-${jobName}.json`), JSON.stringify(acc));
+};
+
+module.exports = { ENABLED, COLOR, MODULE_KEY, analyse, merge, instrument, collect };
