diff --git a/compare-shots.cjs b/compare-shots.cjs
new file mode 100644
index 0000000..65d9e5b
--- /dev/null
+++ b/compare-shots.cjs
@@ -0,0 +1,129 @@
+'use strict';
+// App against app: compares two screenshot folders (e.g. a saved baseline and a new out/shots) pixel by pixel.
+// Usage: node compare-shots.cjs <baseline dir> <new dir> [--tolerance <0-255>] [--threshold <pixels>]
+//          [--exclude <name,...>] [--diff <dir>]
+//   --tolerance  a pixel differs when one of its channels is off by more than this (default 0: any change)
+//   --threshold  a shot fails when more than this many pixels differ (default 0)
+//   --exclude    shot names (without .webp) reported but never failed
+//   --diff       writes <name>.png (baseline | new | difference in red) for every differing shot
+// Exits 1 when a shot differs beyond the threshold, changes size, or exists in only one folder.
+const fs = require('node:fs');
+const path = require('node:path');
+const { deps } = require('./lib.cjs');
+
+const args = process.argv.slice(2);
+const opt = (name, fallback) => {
+    const i = args.indexOf(name);
+    if (i === -1) {
+        return fallback;
+    }
+    const value = args[i + 1];
+    args.splice(i, 2);
+    return value;
+};
+const tolerance = Number(opt('--tolerance', 0));
+const threshold = Number(opt('--threshold', 0));
+const exclude = new Set((opt('--exclude', '') || '').split(',').filter(Boolean));
+const diffDir = opt('--diff', null);
+if (args.length !== 2) {
+    console.error('Usage: node compare-shots.cjs <baseline dir> <new dir> [--tolerance n] [--threshold n] [--exclude a,b] [--diff dir]');
+    process.exit(1);
+}
+const [aDir, bDir] = args;
+const sharp = deps.sharp;
+
+const list = (dir) => new Set(fs.readdirSync(dir).filter((f) => f.endsWith('.webp')).map((f) => f.slice(0, -5)));
+
+const raw = async (file) => {
+    const { data, info } = await sharp(file).ensureAlpha().raw().toBuffer({ resolveWithObject: true });
+    return { data, width: info.width, height: info.height };
+};
+
+const main = async () => {
+    const started = Date.now();
+    const a = list(aDir);
+    const b = list(bDir);
+    const names = [...new Set([...a, ...b])].sort();
+    const rows = [];
+    let failed = 0;
+    for (const name of names) {
+        const excluded = exclude.has(name);
+        if (!a.has(name) || !b.has(name)) {
+            rows.push(`${excluded ? 'excl' : 'FAIL'} ${name}: only in ${a.has(name) ? 'baseline' : 'new'}`);
+            failed += excluded ? 0 : 1;
+            continue;
+        }
+        const fa = path.join(aDir, `${name}.webp`);
+        const fb = path.join(bDir, `${name}.webp`);
+        if (fs.readFileSync(fa).equals(fs.readFileSync(fb))) {
+            continue; // byte-identical
+        }
+        const [x, y] = await Promise.all([raw(fa), raw(fb)]);
+        if (x.width !== y.width || x.height !== y.height) {
+            rows.push(`${excluded ? 'excl' : 'FAIL'} ${name}: size ${x.width}x${x.height} -> ${y.width}x${y.height}`);
+            failed += excluded ? 0 : 1;
+            continue;
+        }
+        let count = 0;
+        let maxDelta = 0;
+        let box = null;
+        const mask = diffDir ? Buffer.alloc(x.width * x.height) : null;
+        for (let p = 0, i = 0; i < x.data.length; p++, i += 4) {
+            let d = 0;
+            for (let c = 0; c < 4; c++) {
+                d = Math.max(d, Math.abs(x.data[i + c] - y.data[i + c]));
+            }
+            if (d > tolerance) {
+                count++;
+                const px = p % x.width;
+                const py = (p - px) / x.width;
+                box = box
+                    ? [Math.min(box[0], px), Math.min(box[1], py), Math.max(box[2], px), Math.max(box[3], py)]
+                    : [px, py, px, py];
+                if (mask) {
+                    mask[p] = 1;
+                }
+            }
+            maxDelta = Math.max(maxDelta, d);
+        }
+        if (count === 0) {
+            continue; // differs only within the tolerance (or only in encoding)
+        }
+        const bad = count > threshold && !excluded;
+        failed += bad ? 1 : 0;
+        rows.push(
+            `${bad ? 'FAIL' : excluded ? 'excl' : 'ok~ '} ${name}: ${count} px differ (max channel delta ${maxDelta}, box ${box[0]},${box[1]}-${box[2]},${box[3]})`,
+        );
+        if (diffDir) {
+            fs.mkdirSync(diffDir, { recursive: true });
+            const d = Buffer.from(y.data);
+            for (let p = 0; p < mask.length; p++) {
+                if (mask[p]) {
+                    d[p * 4] = 255;
+                    d[p * 4 + 1] = 0;
+                    d[p * 4 + 2] = 0;
+                    d[p * 4 + 3] = 255;
+                }
+            }
+            const w = x.width;
+            const h = x.height;
+            const img = (data) => ({ input: data, raw: { width: w, height: h, channels: 4 } });
+            await sharp({ create: { width: w * 3, height: h, channels: 4, background: '#fff' } })
+                .composite([
+                    { ...img(x.data), left: 0, top: 0 },
+                    { ...img(y.data), left: w, top: 0 },
+                    { ...img(d), left: 2 * w, top: 0 },
+                ])
+                .png()
+                .toFile(path.join(diffDir, `${name}.png`));
+        }
+    }
+    for (const row of rows) {
+        console.log(row);
+    }
+    console.log(
+        `\n${names.length} shot(s) compared, ${rows.length} differ (tolerance ${tolerance}, threshold ${threshold} px), ${failed} failing; ${((Date.now() - started) / 1000).toFixed(1)}s`,
+    );
+    process.exit(failed > 0 ? 1 : 0);
+};
+main();
