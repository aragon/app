{
    "compilerOptions": {
        "esModuleInterop": true,
        "incremental": true,
        "isolatedModules": true,
        "lib": [
            "esnext"
        ],
        "module": "esnext",
        "moduleResolution": "bundler",
        "noEmit": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "strict": true,
        "target": "ES2022"
    }
}
