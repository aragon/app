{
    "$schema": "../node_modules/@biomejs/biome/configuration_schema.json",
    "root": false,
    "extends": "//",
    "files": {
        // files.includes of a nested config replaces the root list, so the shared exclusions repeat here.
        // canvas/ is written by the claude.ai canvas editor and synced back verbatim: reformatting it breaks the round-trip.
        // baseline-check/cms/ is a verbatim snapshot of the app-cms files, kept byte-identical to upstream.
        "includes": [
            "**",
            "!**/*.svg",
            "!canvas",
            "!reference",
            "!baseline-check/cms"
        ]
    },
    "overrides": [
        {
            // Command-line scripts: they report progress and failures on the console.
            "includes": [
                "baseline-check/**"
            ],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noConsole": "off"
                    }
                }
            }
        }
    ]
}
